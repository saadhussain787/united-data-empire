// FILE: prisma/schema.prisma
// Master Enterprise Schema v6.1: The 6-Pillar Empire & Moneyball Upgrade

generator client {
  provider = "prisma-client-js"
}

generator frontendClient {
  provider = "prisma-client-js"
  output   = "../frontend/node_modules/.prisma/client"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ----------------------------------------------------
// 1. SQUAD & PLAYERS
// ----------------------------------------------------
model Player {
  id          Int       @id @default(autoincrement())
  apiId       Int       @unique
  name        String
  firstname   String?
  lastname    String?
  age         Int?
  birthDate   DateTime?
  nationality String?
  height      String?
  weight      String?
  number      Int?
  position    String?
  photo       String?

  preferredFoot String?
  contractEnd   DateTime?
  agent         String?
  bootSponsor   String?

  isActiveSquad Boolean @default(true)
  isOnLoan      Boolean @default(false)
  loanClub      String?
  injured       Boolean @default(false)
  injuryDetail  String?
  injuryReturn  String?

  mediaSentiment Float?
  aiSummary      String?

  matchStats    MatchStat[]
  transfers     Transfer[]
  attributes    PlayerAttribute?
  marketValues  MarketValue[]
  careerHistory CareerHistory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// 2. MATCHES & REALTIME EVENTS
// ----------------------------------------------------
model Match {
  id           Int      @id @default(autoincrement())
  apiFixtureId Int      @unique
  date         DateTime
  status       String
  statusLong   String?
  elapsed      Int?
  venue        String?
  referee      String?
  competition  String
  round        String?
  season       Int

  homeTeamId   Int
  homeTeamName String
  homeTeamLogo String
  homeScore    Int?

  awayTeamId   Int
  awayTeamName String
  awayTeamLogo String
  awayScore    Int?

  halftimeScore String?
  fulltimeScore String?

  homeGoalscorers Json?
  awayGoalscorers Json?
  cards           Json?
  substitutions   Json?
  shotData        Json?

  teamStats     Json?
  intervalStats Json?

  stats MatchStat[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// 3. MATCH STATS & OPTA ANALYTICS
// ----------------------------------------------------
model MatchStat {
  id       Int     @id @default(autoincrement())
  matchId  Int
  match    Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId Int?
  player   Player? @relation(fields: [playerId], references: [id], onDelete: SetNull)

  minutes       Int     @default(0)
  rating        Float?
  goals         Int     @default(0)
  assists       Int     @default(0)
  shotsTotal    Int     @default(0)
  shotsOnTarget Int     @default(0)
  passesTotal   Int     @default(0)
  passesKey     Int     @default(0)
  passAccuracy  Float?
  tackles       Int     @default(0)
  blocks        Int     @default(0)
  interceptions Int     @default(0)
  duelsTotal    Int     @default(0)
  duelsWon      Int     @default(0)
  yellowCards   Int     @default(0)
  redCards      Int     @default(0)
  saves         Int     @default(0)
  goalsConceded Int     @default(0)
  cleanSheet    Boolean @default(false)

  xG                  Float?
  xA                  Float?
  npXG                Float?
  xGBuildup           Float?
  progressivePasses   Int?
  progressiveCarries  Int?
  shotCreatingActions Int?

  rawStatsJson Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// 4. FINANCIAL VAULT & TRANSFERS
// ----------------------------------------------------
model Transfer {
  id            Int       @id @default(autoincrement())
  playerId      Int?
  player        Player?   @relation(fields: [playerId], references: [id], onDelete: SetNull)
  playerName    String
  season        String
  window        String
  date          DateTime?
  isIncoming    Boolean
  otherClub     String
  otherClubLogo String?
  fee           String
  transferType  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// 5. PLAYER ATTRIBUTES (FBref Radar Charts)
// ----------------------------------------------------
model PlayerAttribute {
  id       Int    @id @default(autoincrement())
  playerId Int    @unique
  player   Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  pace      Float @default(50.0)
  shooting  Float @default(50.0)
  passing   Float @default(50.0)
  dribbling Float @default(50.0)
  defending Float @default(50.0)
  physical  Float @default(50.0)

  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// 6. MARKET VALUE EVOLUTION
// ----------------------------------------------------
model MarketValue {
  id            Int      @id @default(autoincrement())
  playerId      Int
  player        Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  date          DateTime
  year          Int
  valueMillions Float
  clubName      String?

  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// 7. CAREER HISTORY
// ----------------------------------------------------
model CareerHistory {
  id          Int     @id @default(autoincrement())
  playerId    Int
  player      Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  clubName    String
  clubLogo    String?
  season      String
  appearances Int     @default(0)
  goals       Int     @default(0)
  assists     Int     @default(0)

  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// 8. 3D TROPHY CABINET
// ----------------------------------------------------
model Trophy {
  id              Int      @id @default(autoincrement())
  competitionName String   @unique
  totalCount      Int      @default(0)
  winningSeasons  String[]
  trophyImage     String?

  updatedAt DateTime @updatedAt
}

// ----------------------------------------------------
// 9. HISTORICAL TOURNAMENT LEDGER
// ----------------------------------------------------
model HistoricalCampaign {
  id          Int     @id @default(autoincrement())
  season      String
  competition String
  milestone   String
  isChampion  Boolean @default(false)

  createdAt DateTime @default(now())
}

// ----------------------------------------------------
// 10. MANAGER DOSSIER
// ----------------------------------------------------
model Manager {
  id            Int       @id @default(autoincrement())
  name          String
  photo         String?
  appointedDate DateTime
  leftDate      DateTime?
  isCurrent     Boolean   @default(true)

  totalMatches   Int     @default(0)
  wins           Int     @default(0)
  draws          Int     @default(0)
  losses         Int     @default(0)
  winPercentage  Float?
  preferredShape String?
  transferSpend  Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
